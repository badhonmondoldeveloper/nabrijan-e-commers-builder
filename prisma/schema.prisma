generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// USER & AUTH SYSTEM
// --------------------------------------------------------

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  name            String
  avatar          String?
  phone           String?
  role            String         @default("MERCHANT") // SUPER_ADMIN, MERCHANT, USER
  isEmailVerified Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions            Session[]
  stores              Store[]              @relation("StoreOwner")
  subscriptions       Subscription[]
  themePurchases      ThemePurchase[]
  staffMemberships    Staff[]
  auditLogs           AuditLog[]           @relation("UserAuditLogs")
  trials              Trial[]
  tickets             SupportTicket[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  affiliateProfile    AffiliateProfile?
  referredMapping     ReferralMapping?     @relation("ReferredUser")

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// --------------------------------------------------------
// STORE & MULTI-TENANCY CORE
// --------------------------------------------------------

model Store {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  logo         String?
  banner       String?
  category     String?
  status       String        @default("ACTIVE")
  ownerId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner        User          @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  settings     StoreSettings?
  products     Product[]
  marketplaceListings MarketplaceListing[]
  categories   Category[]
  brands       Brand[]
  orders       Order[]
  sellerOrders SellerOrder[]
  customers    Customer[]
  inventoryTxs InventoryTransaction[]
  coupons      Coupon[]
  reviews      Review[]
  shippingZones ShippingZone[]
  themeSettings StoreThemeSettings?
  media        Media[]
  staff        Staff[]
  domains      Domain[]
  subscriptions Subscription[]
  auditLogs    AuditLog[]
  aiUsages     AiUsage[]
  courierIntegration CourierIntegration?
  shipments    Shipment[]
  notificationTemplates NotificationTemplate[]
  notificationLogs NotificationLog[]
  abandonedCarts AbandonedCart[]
  trials       Trial[]
  wishlists    Wishlist[]
  returns      ReturnRequest[]
  loyaltyAccounts LoyaltyAccount[]
  referrals    Referral[]
  bundles      ProductBundle[]
  upsells      UpsellRule[]
  workflows    AutomationWorkflow[]
  tickets      SupportTicket[]
  wallet       SellerWallet?

  @@index([ownerId])
  @@index([slug])
}

model StoreSettings {
  id             String   @id @default(cuid())
  storeId        String   @unique
  currency       String   @default("BDT")
  currencySymbol String   @default("৳")
  language       String   @default("bn")
  country        String   @default("BD")
  phone          String?
  email          String?
  address        String?
  whatsappNumber String?
  facebookUrl    String?
  instagramUrl   String?
  announcementText String? @db.Text
  accentColor    String?  @default("#2563eb")
  enableCOD      Boolean  @default(true)
  enableTax      Boolean  @default(false)
  taxRate        Decimal  @default(0.00) @db.Decimal(5, 2)
  seoTitle       String?
  seoDescription String?  @db.Text
  metaKeywords   String?
  customCss      String?  @db.Text

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// SUBSCRIPTION & PLATFORM BILLING
// --------------------------------------------------------

model Plan {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?
  price               Decimal  @db.Decimal(12, 2)
  billingCycle        String   @default("MONTHLY") // MONTHLY, YEARLY
  storeLimit          Int      @default(1)
  productLimit        Int      @default(100)
  staffLimit          Int      @default(2)
  storageLimit        Int      @default(500) // MB
  customDomainAllowed Boolean  @default(false)
  aiCredits           Int      @default(50)
  features            String   @default("[]") // JSON string array
  isPopular           Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
  planFeatures  PlanFeature[]
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  storeId            String?
  planId             String
  status             String    @default("TRIALING") // TRIALING, ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEndsAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store    Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]
  events   SubscriptionEvent[]

  @@index([userId])
  @@index([storeId])
}

model Invoice {
  id             String    @id @default(cuid())
  subscriptionId String
  userId         String
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("BDT")
  status         String    @default("PENDING") // PENDING, PAID, FAILED
  invoicePdf     String?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  referenceId     String
  type            String   // PLATFORM_SUBSCRIPTION, TEMPLATE_PURCHASE, STORE_ORDER
  provider        String   // ZINIPAY, COD, MANUAL
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("BDT")
  status          String   @default("PENDING") // PENDING, PAID, FAILED
  gatewayTxnId    String?
  gatewayResponse String?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([referenceId])
  @@index([gatewayTxnId])
}

// --------------------------------------------------------
// COMMERCE: PRODUCTS, VARIANTS, CATEGORIES, BRANDS
// --------------------------------------------------------

model Product {
  id                String   @id @default(cuid())
  storeId           String
  title             String
  slug              String
  shortDescription  String?  @db.Text
  fullDescription   String?  @db.Text
  regularPrice      Decimal  @db.Decimal(12, 2)
  salePrice         Decimal? @db.Decimal(12, 2)
  costPrice         Decimal  @default(0.00) @db.Decimal(12, 2)
  sku               String?
  barcode           String?
  categoryId        String?
  brandId           String?
  status            String   @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  weight            Decimal? @default(0.00) @db.Decimal(8, 2)
  isFeatured        Boolean  @default(false)
  isMarketplaceListed Boolean @default(false)
  marketplaceStatus  String   @default("APPROVED")
  marketplaceCategory String?
  isFeaturedMarketplace Boolean @default(false)
  boostExpiresAt    DateTime?
  productType       String   @default("PHYSICAL") // PHYSICAL, DIGITAL
  seoTitle          String?
  seoDescription    String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  attributes   ProductAttribute[]
  reviews      Review[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  inventoryTxs InventoryTransaction[]
  wishlistItems WishlistItem[]
  bundleItems  BundleItem[]
  marketplaceListing MarketplaceListing?

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
}

model MarketplaceListing {
  id                  String    @id @default(cuid())
  productId           String    @unique
  storeId             String
  status              String    @default("ACTIVE") // ACTIVE, INACTIVE
  moderationStatus    String    @default("APPROVED") // PENDING, APPROVED, REJECTED, SUSPENDED
  marketplaceCategory String?
  isFeatured          Boolean   @default(false)
  boostExpiresAt      DateTime?
  rejectionReason     String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([moderationStatus])
  @@index([marketplaceCategory])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  title      String
  sku        String?
  price      Decimal  @db.Decimal(12, 2)
  salePrice  Decimal? @db.Decimal(12, 2)
  stock      Int      @default(0)
  weight     Decimal? @db.Decimal(8, 2)
  status     Boolean  @default(true)
  image      String?
  attributes String   // JSON key-value string

  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  cartItems    CartItem[]
  inventoryTxs InventoryTransaction[]
}

model ProductAttribute {
  id        String @id @default(cuid())
  productId String
  name      String // Color, Size
  values    String // JSON string array

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  slug           String
  description    String?
  image          String?
  banner         String?
  parentId       String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model CategoryCommission {
  id             String   @id @default(cuid())
  categoryName   String   @unique
  commissionRate Decimal  @default(0.02) @db.Decimal(5, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Brand {
  id       String    @id @default(cuid())
  storeId  String
  name     String
  slug     String
  logo     String?
  website  String?
  isActive Boolean   @default(true)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
}

// --------------------------------------------------------
// INVENTORY & TRANSACTIONS
// --------------------------------------------------------

model InventoryTransaction {
  id            String   @id @default(cuid())
  storeId       String
  productId     String
  variantId     String?
  type          String   // PURCHASE, SALE, ADJUSTMENT, RETURN, DAMAGE
  quantity      Int
  previousStock Int
  newStock      Int
  reference     String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([productId])
}

// --------------------------------------------------------
// CUSTOMER, CRM & REVIEWS
// --------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  email       String?
  phone       String
  totalOrders Int      @default(0)
  totalSpent  Decimal  @default(0.00) @db.Decimal(12, 2)
  status      String   @default("ACTIVE")
  notes       String?
  tags        String   @default("[]") // JSON string array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]
  reviews   Review[]

  @@unique([storeId, phone])
  @@index([storeId])
}

model CustomerAddress {
  id            String  @id @default(cuid())
  customerId    String
  title         String  @default("Home")
  recipientName String
  phone         String
  division      String
  district      String
  area          String
  addressLine   String
  isDefault     Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Review {
  id                 String   @id @default(cuid())
  storeId            String
  productId          String
  customerId         String?
  customerName       String
  rating             Int      @default(5)
  title              String?
  comment            String
  status             String   @default("APPROVED")
  isVerifiedPurchase Boolean  @default(false)
  createdAt          DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([productId])
}

// --------------------------------------------------------
// CART & ORDERS (MULTI-SELLER & STORE CHECKOUT)
// --------------------------------------------------------

model Cart {
  id         String   @id @default(cuid())
  storeId    String
  sessionId  String   @unique
  customerId String?
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model MarketplaceOrder {
  id               String   @id @default(cuid())
  orderNumber      String   @unique
  buyerName        String
  buyerPhone       String
  buyerEmail       String?
  shippingDivision String
  shippingDistrict String
  shippingArea     String?
  shippingAddress  String
  totalAmount      Decimal  @db.Decimal(12, 2)
  paymentMethod    String   @default("COD")
  paymentStatus    String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  idempotencyKey   String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sellerOrders SellerOrder[]
}

model SellerOrder {
  id                 String   @id @default(cuid())
  marketplaceOrderId String
  storeId            String
  orderNumber        String   @unique
  subtotal           Decimal  @db.Decimal(12, 2)
  shippingFee        Decimal  @default(0.00) @db.Decimal(12, 2)
  commissionAmount   Decimal  @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal  @db.Decimal(12, 2)
  netSellerAmount    Decimal  @db.Decimal(12, 2)
  orderStatus        String   @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  paymentStatus      String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  fulfillmentStatus  String   @default("UNFULFILLED") // UNFULFILLED, SHIPPED, DELIVERED
  settlementStatus   String   @default("UNSETTLED") // UNSETTLED, PENDING_CLEARANCE, CLEARED, SETTLED
  clearanceDate      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  marketplaceOrder MarketplaceOrder @relation(fields: [marketplaceOrderId], references: [id], onDelete: Cascade)
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items            OrderItem[]

  @@index([storeId])
  @@index([orderStatus])
}

model Order {
  id               String   @id @default(cuid())
  storeId          String
  orderNumber      String
  customerId       String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  shippingDivision String
  shippingDistrict String
  shippingArea     String
  shippingAddress  String
  notes            String?
  paymentMethod    String   @default("COD")
  paymentStatus    String   @default("PENDING") // PENDING, PAID, FAILED
  orderStatus      String   @default("PENDING") // PENDING, CONFIRMED, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  subtotal         Decimal  @db.Decimal(12, 2)
  discountAmount   Decimal  @default(0.00) @db.Decimal(12, 2)
  shippingFee      Decimal  @default(0.00) @db.Decimal(12, 2)
  totalAmount      Decimal  @db.Decimal(12, 2)
  currency         String   @default("BDT")
  exchangeRate     Decimal  @default(1.00) @db.Decimal(8, 4)
  estimatedProfit  Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  shipment       Shipment?
  returnRequests ReturnRequest[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([customerPhone])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String?
  sellerOrderId String?
  productId     String
  variantId     String?
  productTitle  String
  variantTitle  String?
  sku           String?
  price         Decimal  @db.Decimal(12, 2)
  costPrice     Decimal  @default(0.00) @db.Decimal(12, 2)
  quantity      Int
  total         Decimal  @db.Decimal(12, 2)

  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model MarketplaceCommission {
  id                 String   @id @default(cuid())
  marketplaceOrderId String?
  sellerOrderId      String?
  orderItemId        String?
  storeId            String
  commissionRate     Decimal  @db.Decimal(5, 4) // e.g. 0.0200 for 2%
  grossAmount        Decimal  @db.Decimal(12, 2)
  commissionAmount   Decimal  @db.Decimal(12, 2)
  sellerNetAmount    Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  @@index([storeId])
  @@index([sellerOrderId])
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  comment     String?
  changedById String?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// SHIPPING & DISCOUNTS
// --------------------------------------------------------

model ShippingZone {
  id       String   @id @default(cuid())
  storeId  String
  name     String
  regions  String   @default("[]") // JSON string array
  isActive Boolean  @default(true)

  store Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates ShippingRate[]

  @@index([storeId])
}

model ShippingRate {
  id            String   @id @default(cuid())
  zoneId        String
  name          String
  rateType      String   @default("FLAT_RATE")
  minWeight     Decimal? @default(0.00) @db.Decimal(8, 2)
  maxWeight     Decimal? @db.Decimal(8, 2)
  minOrderPrice Decimal? @default(0.00) @db.Decimal(12, 2)
  maxOrderPrice Decimal? @db.Decimal(12, 2)
  price         Decimal  @db.Decimal(12, 2)
  estimatedDays String?  @default("2-3 days")

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model Coupon {
  id               String    @id @default(cuid())
  storeId          String
  code             String
  discountType     String    @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT, FREE_SHIPPING
  amount           Decimal   @db.Decimal(12, 2)
  minPurchase      Decimal?  @default(0.00) @db.Decimal(12, 2)
  maxDiscount      Decimal?  @db.Decimal(12, 2)
  usageLimit       Int?
  usedCount        Int       @default(0)
  startDate        DateTime?
  endDate          DateTime?
  isFirstOrderOnly Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId])
}

// --------------------------------------------------------
// WISHLIST
// --------------------------------------------------------

model Wishlist {
  id         String   @id @default(cuid())
  storeId    String
  customerId String?
  sessionId  String?
  createdAt  DateTime @default(now())

  store Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String @id @default(cuid())
  wishlistId String
  productId  String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// DYNAMIC THEME ENGINE & MARKETPLACE
// --------------------------------------------------------

model Theme {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String
  previewImage String
  demoUrl      String?
  price        Decimal  @default(0.00) @db.Decimal(12, 2)
  isFree       Boolean  @default(true)
  isOfficial   Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchases ThemePurchase[]
  storeSettings StoreThemeSettings[]
}

model ThemePurchase {
  id            String   @id @default(cuid())
  userId        String
  themeId       String
  amount        Decimal  @db.Decimal(12, 2)
  transactionId String?
  createdAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)
}

model StoreThemeSettings {
  id               String   @id @default(cuid())
  storeId          String   @unique
  themeId          String
  headerConfig     String   // JSON string
  footerConfig     String   // JSON string
  colorsConfig     String   // JSON string
  typographyConfig String   // JSON string
  customStyles     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  theme    Theme          @relation(fields: [themeId], references: [id])
  sections ThemeSection[]
}

model ThemeSection {
  id                   String  @id @default(cuid())
  storeThemeSettingsId String
  sectionType          String
  title                String?
  subtitle             String?
  content              String  // JSON string
  sortOrder            Int     @default(0)
  isVisible            Boolean @default(true)

  themeSettings StoreThemeSettings @relation(fields: [storeThemeSettingsId], references: [id], onDelete: Cascade)
}

// --------------------------------------------------------
// MEDIA LIBRARY
// --------------------------------------------------------

model Media {
  id        String   @id @default(cuid())
  storeId   String
  fileName  String
  fileUrl   String
