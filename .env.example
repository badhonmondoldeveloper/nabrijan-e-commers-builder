# Database Configuration (cPanel MySQL)
DATABASE_URL="mysql://username:password@localhost:3306/nabrijan_db"

# Auth & Session Security
JWT_SECRET="super-secret-jwt-key-nabrijan-saas-2026-production-ready"
AUTH_SECRET="super-secret-auth-key-nabrijan-saas-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ZiniPay Platform Gateway Credentials
ZINIPAY_API_KEY="zinipay_demo_api_key"
ZINIPAY_SECRET_KEY="zinipay_demo_secret_key"
ZINIPAY_BASE_URL="https://api.zinipay.com/v1"
ZINIPAY_WEBHOOK_SECRET="zinipay_demo_webhook_secret"
ZINIPAY_MERCHANT_ID="merchant_demo_123"

# Feature Flags
ENABLE_ZINIPAY=true
ENABLE_MANUAL_PAYMENT=false
ENABLE_BKASH=false
ENABLE_NAGAD=false
ENABLE_AI=false
ENABLE_APP_MARKETPLACE=false
ENABLE_CUSTOM_DOMAIN=true
