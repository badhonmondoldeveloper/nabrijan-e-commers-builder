// --------------------------------------------------------
// 15% RECURRING AFFILIATE SYSTEM
// --------------------------------------------------------

model AffiliateProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  code             String            @unique
  status           String            @default("ACTIVE") // PENDING_REVIEW, ACTIVE, SUSPENDED
  payoutMethod     String            @default("bkash") // bkash, nagad
  payoutNumber     String
  totalClicks      Int               @default(0)
  totalEarnings    Decimal           @default(0.00) @db.Decimal(12, 2)
  availableBalance Decimal           @default(0.00) @db.Decimal(12, 2)
  paidOutAmount    Decimal           @default(0.00) @db.Decimal(12, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals        ReferralMapping[] @relation("AffiliateReferrals")
  earnings         AffiliateEarning[]
  payoutRequests   PayoutRequest[]

  @@index([code])
  @@index([userId])
}

model ReferralMapping {
  id                String           @id @default(cuid())
  affiliateId       String
  referredUserId    String           @unique
  referredUserEmail String?
  createdAt         DateTime         @default(now())

  affiliate         AffiliateProfile @relation("AffiliateReferrals", fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser      User             @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([referredUserId])
}

model AffiliateEarning {
  id                 String           @id @default(cuid())
  affiliateId        String
  referredUserId     String
  paymentTxnId       String?
  subscriptionAmount Decimal          @db.Decimal(12, 2)
  commissionRate     Decimal          @default(15.00) @db.Decimal(5, 2)
  commissionAmount   Decimal          @db.Decimal(12, 2)
  status             String           @default("APPROVED") // APPROVED, PENDING, CANCELLED
  description        String?
  createdAt          DateTime         @default(now())

  affiliate          AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([referredUserId])
}

model PayoutRequest {
  id             String           @id @default(cuid())
  affiliateId    String
  amount         Decimal          @db.Decimal(12, 2)
  paymentMethod  String
  accountNumber  String
  status         String           @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote      String?
  transactionId  String?
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  affiliate      AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
}

