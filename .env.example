# ========================================================
# NABRIJAN E-COMMERCE SAAS — PRODUCTION ENVIRONMENT TEMPLATE
# ========================================================
# DO NOT COMMIT ACTUAL SECRETS TO GIT REPOSITORIES!
# Copy this file to '.env' on your production server (cPanel / Vercel)
# and fill in your confidential production credentials.

# --------------------------------------------------------
# DATABASE CONFIGURATION (cPanel MySQL / PostgreSQL)
# --------------------------------------------------------
DATABASE_URL="mysql://cpanel_db_user:StrongPassword123!@localhost:3306/cpanel_nabrijan_db"

# --------------------------------------------------------
# AUTHENTICATION & SECURITY KEYS
# --------------------------------------------------------
# Generate strong 64-character random strings for production:
# Command: openssl rand -base64 32
JWT_SECRET="replace-with-super-secure-production-jwt-secret-key-min-32-chars"
AUTH_SECRET="replace-with-super-secure-production-auth-secret-key-min-32-chars"

# --------------------------------------------------------
# APPLICATION URLS
# --------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://nabrijan.site"
APP_URL="https://nabrijan.site"

# --------------------------------------------------------
# PAYMENT GATEWAY (ZiniPay Production / Demo Settings)
# --------------------------------------------------------
ZINIPAY_API_KEY="your_production_zinipay_api_key"
ZINIPAY_SECRET_KEY="your_production_zinipay_secret_key"
ZINIPAY_BASE_URL="https://api.zinipay.com/v1"
ZINIPAY_WEBHOOK_SECRET="your_production_zinipay_webhook_secret"
ZINIPAY_MERCHANT_ID="your_production_merchant_id"

# --------------------------------------------------------
# TRANSACTIONAL MAIL (SMTP Credentials for Verification & Reset)
# --------------------------------------------------------
SMTP_HOST="mail.nabrijan.site"
SMTP_PORT="587"
SMTP_USER="no-reply@nabrijan.site"
SMTP_PASS="your_email_account_password"
SMTP_FROM="Nabrijan SaaS <no-reply@nabrijan.site>"

# --------------------------------------------------------
# GOOGLE OAUTH 2.0 CREDENTIALS
# --------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --------------------------------------------------------
# FEATURE FLAGS
# --------------------------------------------------------
ENABLE_ZINIPAY=true
ENABLE_MANUAL_PAYMENT=true
ENABLE_BKASH=true
ENABLE_NAGAD=true
ENABLE_AI=false
ENABLE_APP_MARKETPLACE=false
ENABLE_CUSTOM_DOMAIN=true
