// --------------------------------------------------------
// NABRIJAN MARKETPLACE, SELLER WALLET, LEDGER & PROMOTIONS
// --------------------------------------------------------

model SellerWallet {
  id                  String   @id @default(cuid())
  storeId             String   @unique
  balance             Decimal  @default(0.00) @db.Decimal(12, 2)
  pendingBalance      Decimal  @default(0.00) @db.Decimal(12, 2)
  pendingPayouts      Decimal  @default(0.00) @db.Decimal(12, 2)
  totalEarned         Decimal  @default(0.00) @db.Decimal(12, 2)
  totalCommissionPaid Decimal  @default(0.00) @db.Decimal(12, 2)
  totalWithdrawn      Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  store               Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions        LedgerTransaction[]
  settlements         SellerSettlement[]
}

model LedgerTransaction {
  id               String   @id @default(cuid())
  walletId         String
  storeId          String
  orderId          String?
  type             String   // SALE_PENDING, SALE_AVAILABLE, COMMISSION, REFUND, COMMISSION_REVERSAL, SETTLEMENT, SETTLEMENT_REVERSAL, BOOST_PURCHASE, ADJUSTMENT_CREDIT, ADJUSTMENT_DEBIT
  amount           Decimal  @db.Decimal(12, 2)
  commissionAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  netAmount        Decimal  @db.Decimal(12, 2)
  currency         String   @default("BDT")
  referenceId      String?
  description      String
  createdAt        DateTime @default(now())

  wallet SellerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([storeId])
  @@index([type])
}

model SellerSettlement {
  id                   String    @id @default(cuid())
  walletId             String
  storeId              String
  amount               Decimal   @db.Decimal(12, 2)
  status               String    @default("PENDING") // PENDING, ELIGIBLE, PROCESSING, PAID, FAILED, REVERSED, CANCELLED
  paymentMethod        String    @default("BKASH")
  accountDetails       String
  notes                String?
  adminNotes           String?
  transactionId        String?
  processedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  wallet SellerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([storeId])
  @@index([status])
}

model BoostPackage {
  id           String   @id @default(cuid())
